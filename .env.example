# ---------------------------------------------------------------------------
# CreeperClips configuration. Copy to `.env` and adjust for your machine.
# ---------------------------------------------------------------------------

# Postgres (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://creeper:creeper@localhost:5432/creeperclips?schema=public"

# Redis for the BullMQ job queue (matches docker-compose.yml defaults)
REDIS_URL="redis://localhost:6379"

# Where source videos and rendered clips are stored on disk.
# Source videos -> $MEDIA_DIR/source, clips -> $MEDIA_DIR/clips, thumbs -> $MEDIA_DIR/thumbnails
MEDIA_DIR="./media"

# Optional: a folder your friend drops gameplay files into (e.g. a synced
# Dropbox/Drive folder). New video files here are auto-imported. Leave blank to disable.
WATCH_FOLDER=""

# Python interpreter used to run the processing scripts. Use the one with
# faster-whisper + librosa installed (e.g. ./python/.venv/bin/python).
PYTHON_BIN="python3"

# faster-whisper model size: tiny | base | small | medium | large-v3
WHISPER_MODEL="base"
# cpu or cuda
WHISPER_DEVICE="cpu"

# ---------------------------------------------------------------------------
# OPTIONAL: Discord notification webhook (fires when a clip is ready).
# Leave blank to disable.
# ---------------------------------------------------------------------------
DISCORD_WEBHOOK_URL=""

# ---------------------------------------------------------------------------
# OPTIONAL: Direct social posting (DISABLED by default).
# These are ONLY needed if you flip ENABLE_DIRECT_POSTING=true and complete each
# platform's own auth + app review yourself. See README "Optional: enabling
# direct social posting". The core export-to-folder workflow needs none of these.
# ---------------------------------------------------------------------------
ENABLE_DIRECT_POSTING="false"

# YouTube Data API (OAuth2)
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REFRESH_TOKEN=""

# Instagram Graph API
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_BUSINESS_ACCOUNT_ID=""

# TikTok Content Posting API
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_ACCESS_TOKEN=""
